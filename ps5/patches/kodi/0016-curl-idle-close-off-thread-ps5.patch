+namespace
+{
+// Tearing down an idle curl session (multi_remove_handle / easy_cleanup /
+// multi_cleanup) can block for a long time - a keep-alive HTTPS connection to
+// a slow mirror can sit in TLS/socket shutdown until curl's timeout (tens of
+// seconds). CheckIdle() runs on the application thread (CApplication::
+// ProcessSlow, every ~500 ms), and previously did this teardown while holding
+// m_critSection, so one stuck close froze the GUI for the whole timeout and
+// blocked every other curl transfer waiting on the lock. The sessions to close
+// are now spliced out of the live pool under the lock (fast) and their teardown
+// is done here, off the application thread. Each closed session was already
+// idle and not busy, so no other thread references its handles.
+void CloseSessions(DllLibCurlGlobal& curl, const std::vector<DllLibCurlGlobal::SSession>& sessions)
+{
+  for (const auto& s : sessions)
+  {
+    if (s.m_multi && s.m_easy)
+      curl.multi_remove_handle(s.m_multi, s.m_easy);
+    if (s.m_easy)
+      curl.easy_cleanup(s.m_easy);
+    if (s.m_multi)
+      curl.multi_cleanup(s.m_multi);
+  }
+}
+
+class CCurlCloseJob : public CJob
+{
+public:
+  // Takes its own copy of the session list: CJobManager::AddJob deletes the
+  // job when it cannot queue it (shutdown) and may return before the caller
+  // can tell, so the caller keeps the original list and must stay able to
+  // close the handles itself. SSession destruction never touches the handles,
+  // so whichever copy goes unused is destroyed without effect.
+  CCurlCloseJob(const std::vector<DllLibCurlGlobal::SSession>& sessions, DllLibCurlGlobal* owner)
+    : m_sessions(sessions), m_owner(owner)
+  {
+  }
+
+  const char* GetType() const override { return "curl-close"; }
+
+  bool DoWork() override
+  {
+    CloseSessions(*m_owner, m_sessions);
+    return true;
+  }
+
+private:
+  std::vector<DllLibCurlGlobal::SSession> m_sessions;
+  DllLibCurlGlobal* m_owner;
+};
+} // namespace
