 #include "threads/SystemClock.h"
+#include "jobs/Job.h"
+#include "jobs/JobManager.h"
 #include "utils/log.h"
 
 #include <assert.h>
@@ -136,36 +139,96 @@ DllLibCurlGlobal::~DllLibCurlGlobal()
   curl_global_cleanup();
